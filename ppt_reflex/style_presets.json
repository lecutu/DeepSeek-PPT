    "corporate_minimal": {
      "display_name": "Corporate Minimal",
      "mood": "Professional, calm, trustworthy",
      "theme": "light",
      "color_override": {
        "bg": "#FFFFFF",
        "surface": "#F4F6F9",
        "text_primary": "#0F172A",
        "text_secondary": "#475569",
        "accent": "#1D4ED8",
        "accent_soft": "#E8EEFC",
        "on_accent": "#FFFFFF",
        "warn": "#DC2626"
      },
      "shape_override": {
        "corner_radius_pt": {"card": 8, "pill": 999, "chip": 6},
        "shadow": "none",
        "border_pt": 1
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 28,
        "scale_h2": 18,
        "scale_body": 14
      },
      "image_layout": {
        "philosophy": "Images are visual evidence for arguments, not atmospheric decoration",
        "preferred_modes": ["hero_right", "hero_left", "center_float"],
        "mode_constraints": {
          "hero_right": {
            "max_width_pt": 380,
            "max_height_pt": 400,
            "anchor": "center",
            "image_ratio": 0.40
          },
          "hero_left": {
            "max_width_pt": 380,
            "max_height_pt": 400,
            "anchor": "center",
            "image_ratio": 0.40
          },
          "center_float": {
            "max_width_pt": 520,
            "max_height_pt": 340,
            "anchor": "center",
            "image_ratio": 0.55
          },
          "hero_top": {
            "max_width_pt": 840,
            "max_height_pt": 260,
            "anchor": "top_center",
            "image_ratio": 0.45
          }
        },
        "treatment": {
          "corner_radius_pt": 8,
          "border_role": "border_subtle",
          "shadow_role": "soft"
        },
        "caption": {
          "font_size": 11,
          "alignment": "center",
          "max_lines": 1,
          "prefix": ""
        }
      },
      "guidelines": [
        "One accent point per page, everything else grayscale",
        "Use thin lines to separate sections, not color blocks",
        "No gradients, glows, or large rounded corners"
      ],
      "deck_rules": [
        {"field": "font_family", "tier": "lock", "expected": "Microsoft YaHei", "message": "All slides must use the same font family"},
        {"field": "require_cover", "tier": "lock", "expected": true, "message": "Deck must start with a cover slide"},
        {"field": "page_count", "tier": "hint", "expected": [5, 20], "message": "5-20 slides recommended for corporate deck"},
        {"field": "require_agenda", "tier": "hint", "expected": true, "message": "Consider adding an agenda slide after cover"},
        {"field": "require_conclusion", "tier": "hint", "expected": true, "message": "End with a conclusion or contact slide"},
        {"field": "font_size", "tier": "guide", "expected": 14, "tolerance": 0.25, "message": "Body text around 14pt"},
        {"field": "line_spacing", "tier": "guide", "expected": 1.35, "tolerance": 0.20, "message": "Line spacing around 1.35"},
        {"field": "title_size", "tier": "guide", "expected": 28, "tolerance": 0.25, "message": "Title around 28pt"}
      ]
