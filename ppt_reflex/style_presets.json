  "layout_mode_decision_tree": {
    "note": "AI 根据图片宽高比自动选择 layout_mode",
    "rules": [
      {"aspect_gt": 1.6, "mode": "hero_top", "reason": "横图适合占上部全宽"},
      {"aspect_lt": 0.8, "mode": "hero_right", "reason": "竖图适合占一侧"},
      {"aspect_range": "0.8-1.6", "mode": "center_float", "reason": "方形图居中展示"},
      {"width_lt": 64, "mode": "small_inline", "reason": "图标嵌入文字流"}
    ]
  }
