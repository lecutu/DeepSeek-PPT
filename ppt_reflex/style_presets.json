        "text_secondary": "#475569",
        "accent": "#1D4ED8",
        "accent_soft": "#E8EEFC",
        "on_accent": "#FFFFFF",
        "warn": "#DC2626"
      },
      "shape_override": {
        "corner_radius_pt": {"card": 8, "pill": 999, "chip": 6},
        "shadow": "none",
        "border_pt": 1
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 28,
        "scale_h2": 18,
        "scale_body": 14
      },
      "image_layout": {
        "philosophy": "Images are visual evidence for arguments, not atmospheric decoration",
        "preferred_modes": ["hero_right", "hero_left", "center_float"],
        "mode_constraints": {
          "hero_right": {
            "max_width_pt": 380,
            "max_height_pt": 400,
            "anchor": "center",
            "image_ratio": 0.40
          },
          "hero_left": {
            "max_width_pt": 380,
            "max_height_pt": 400,
            "anchor": "center",
            "image_ratio": 0.40
          },
          "center_float": {
            "max_width_pt": 520,
            "max_height_pt": 340,
            "anchor": "center",
            "image_ratio": 0.55
          },
          "hero_top": {
            "max_width_pt": 840,
            "max_height_pt": 260,
            "anchor": "top_center",
            "image_ratio": 0.45
          }
        },
        "treatment": {
          "corner_radius_pt": 8,
          "border_role": "border_subtle",
          "shadow_role": "soft"
        },
        "caption": {
          "font_size": 11,
          "alignment": "center",
          "max_lines": 1,
          "prefix": ""
