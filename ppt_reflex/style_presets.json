  "layout_mode_decision_tree": {
    "note": "AI auto-selects layout_mode from image aspect ratio",
    "rules": [
      {"aspect_gt": 1.6, "mode": "hero_top", "reason": "Landscape images suit full-width top placement"},
      {"aspect_lt": 0.8, "mode": "hero_right", "reason": "Portrait images suit side placement"},
      {"aspect_range": "0.8-1.6", "mode": "center_float", "reason": "Square images suit centered display"},
      {"width_lt": 64, "mode": "small_inline", "reason": "Icons embed in text flow"}
    ]
