{
  "_meta": {
    "version": "1.0",
    "description": "视觉风格预设——覆盖模板颜色/字体/形状。AI 按 audience+occasion+content 选一个预设。用户可修改并保存。",
    "one_per_deck": true,
    "modifiable": true,
    "save_prompt": "每次用户提出风格改进时，询问是否保存到长久模板"
  },
  "selection_guide": {
    "by_audience": {
      "executive_client": [
        "corporate_minimal",
        "government_solemn"
      ],
      "engineers_researchers": [
        "tech_dark",
        "academic_rigorous"
      ],
      "general_public_marketing": [
        "editorial_magazine",
        "creative_playful"
      ]
    },
    "by_occasion": {
      "pitch_consulting": "corporate_minimal",
      "product_launch_demo": "tech_dark",
      "paper_defense_seminar": "academic_rigorous",
      "brand_story_keynote": "editorial_magazine",
      "campaign_social": "creative_playful",
      "official_report_briefing": "government_solemn"
    }
  },
  "presets": {
    "corporate_minimal": {
      "display_name": "商务极简",
      "mood": "专业、冷静、可信",
      "theme": "light",
      "color_override": {
        "bg": "#FFFFFF",
        "surface": "#F4F6F9",
        "text_primary": "#0F172A",
        "text_secondary": "#475569",
        "accent": "#1D4ED8",
        "accent_soft": "#E8EEFC",
        "on_accent": "#FFFFFF",
        "warn": "#DC2626"
      },
      "shape_override": {
        "corner_radius_pt": {
          "card": 8,
          "pill": 999,
          "chip": 6
        },
        "shadow": "none",
        "border_pt": 1
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 28,
        "scale_h2": 18,
        "scale_body": 14
      },
      "guidelines": [
        "一页一个强调色落点，其余全灰阶",
        "用细线分隔区块而非色块堆叠",
        "禁止渐变、发光、大圆角"
      ]
    },
    "tech_dark": {
      "display_name": "科技深色",
      "mood": "前沿、沉浸、戏剧化",
      "theme": "dark",
      "color_override": {
        "bg": "#0B1020",
        "surface": "#141B2D",
        "text_primary": "#EAF0FB",
        "text_secondary": "#A9B6CF",
        "accent": "#22D3EE",
        "accent_soft": "#10303A",
        "on_accent": "#06121A",
        "warn": "#FB7185",
        "success": "#34D399"
      },
      "shape_override": {
        "corner_radius_pt": {
          "card": 14,
          "pill": 999,
          "chip": 8
        },
        "shadow": "lift_accent",
        "border_pt": 1.5
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 36,
        "scale_h2": 20,
        "scale_body": 14
      },
      "guidelines": [
        "暗场只点 1-2 处霓虹，其余靠灰阶层次",
        "霓虹强调色块上文字用深色 on_accent",
        "禁止白字落亮霓虹填充块——深色风最常见的对比事故"
      ]
    },
    "academic_rigorous": {
      "display_name": "学术严谨",
      "mood": "严谨、克制、可信",
      "theme": "light",
      "color_override": {
        "bg": "#FBFAF7",
        "surface": "#FFFFFF",
        "text_primary": "#221F1A",
        "text_secondary": "#57524A",
        "accent": "#7A3B2E",
        "accent_soft": "#EFE3DF",
        "on_accent": "#FFFFFF",
        "warn": "#C2410C"
      },
      "shape_override": {
        "corner_radius_pt": {
          "card": 4,
          "pill": 999,
          "chip": 4
        },
        "shadow": "none",
        "border_pt": 1
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 28,
        "scale_h2": 16,
        "scale_body": 14
      },
      "guidelines": [
        "衬线标题 + 无衬线正文",
        "低饱和配色，模拟印刷品质感",
        "禁止圆角大卡片、阴影、渐变"
      ]
    },
    "editorial_magazine": {
      "display_name": "杂志编辑",
      "mood": "高级、有态度、叙事感",
      "theme": "light",
      "color_override": {
        "bg": "#F7F4EF",
        "surface": "#FFFFFF",
        "text_primary": "#14110E",
        "text_secondary": "#4A443C",
        "accent": "#C2410C",
        "accent_soft": "#F3E2D8",
        "on_accent": "#FFFFFF",
        "warn": "#DC2626"
      },
      "shape_override": {
        "corner_radius_pt": {
          "card": 0,
          "pill": 999,
          "chip": 0
        },
        "shadow": "none",
        "border_pt": 1
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 44,
        "scale_h2": 26,
        "scale_body": 14
      },
      "guidelines": [
        "超大标题 + 不对称网格 + 硬边构图",
        "每页一个强视觉锚点，故意做低信息密度",
        "禁止圆角卡片+阴影的通用模板感"
      ]
    },
    "creative_playful": {
      "display_name": "创意活力",
      "mood": "活泼、友好、年轻",
      "theme": "light",
      "color_override": {
        "bg": "#FFFDF7",
        "surface": "#FFFFFF",
        "text_primary": "#1F2430",
        "text_secondary": "#4B5563",
        "accent": "#FF5A3C",
        "accent_soft": "#FFE3DA",
        "on_accent": "#FFFFFF",
        "warn": "#DC2626"
      },
      "shape_override": {
        "corner_radius_pt": {
          "card": 24,
          "pill": 999,
          "chip": 12
        },
        "shadow": "soft_sticker",
        "border_pt": 2
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 32,
        "scale_h2": 22,
        "scale_body": 14
      },
      "guidelines": [
        "大圆角 + 重字重 + 贴纸硬阴影",
        "单页 ≤2 彩色，多色轮换到整份",
        "装饰几何只放边角点睛"
      ]
    },
    "government_solemn": {
      "display_name": "政务庄重",
      "mood": "庄重、权威、稳重",
      "theme": "light",
      "color_override": {
        "bg": "#FFFFFF",
        "surface": "#F2F4F8",
        "text_primary": "#1A2233",
        "text_secondary": "#44506A",
        "accent": "#B22234",
        "accent_soft": "#F6E3E5",
        "on_accent": "#FFFFFF",
        "warn": "#B22234"
      },
      "shape_override": {
        "corner_radius_pt": {
          "card": 4,
          "pill": 999,
          "chip": 4
        },
        "shadow": "none",
        "border_pt": 1.5
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 28,
        "scale_h2": 18,
        "scale_body": 15
      },
      "guidelines": [
        "标题居中、对称构图",
        "顶部/底部色带或细红线点缀",
        "禁止霓虹、渐变、大圆角、贴纸阴影"
      ]
    }
  }
}