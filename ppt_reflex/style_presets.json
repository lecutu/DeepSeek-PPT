{
  "_meta": {
    "version": "2.0",
    "description": "六种风格预设 + 图片布局策略一体化。每种风格定义色彩/字体/形状 + image_layout 控制图片落位模式。AI 选定 preset 后图片规则随之锁定。",
    "one_per_deck": true,
    "modifiable": true
  },
  "selection_guide": {
    "by_audience": {
      "executive_client": ["corporate_minimal", "government_solemn"],
      "engineers_researchers": ["tech_dark", "academic_rigorous"],
      "general_public_marketing": ["editorial_magazine", "creative_vibrant"]
    },
    "by_occasion": {
      "pitch_consulting": "corporate_minimal",
      "product_launch_demo": "tech_dark",
      "paper_defense_seminar": "academic_rigorous",
      "brand_story_keynote": "editorial_magazine",
      "campaign_social": "creative_vibrant",
      "official_report_briefing": "government_solemn"
    }
  },
  "presets": {
    "corporate_minimal": {
      "display_name": "商务极简",
      "mood": "专业、冷静、可信",
      "theme": "light",
      "color_override": {
        "bg": "#FFFFFF",
        "surface": "#F4F6F9",
        "text_primary": "#0F172A",
        "text_secondary": "#475569",
        "accent": "#1D4ED8",
        "accent_soft": "#E8EEFC",
        "on_accent": "#FFFFFF",
        "warn": "#DC2626"
      },
      "shape_override": {
        "corner_radius_pt": {"card": 8, "pill": 999, "chip": 6},
        "shadow": "none",
        "border_pt": 1
      },
      "font_override": {
        "title_weight": "bold",
        "body_weight": "normal",
        "scale_h1": 28,
        "scale_h2": 18,
        "scale_body": 14
      },
      "image_layout": {
        "philosophy": "图片是论据的视觉证据，不是氛围装饰",
        "preferred_modes": ["hero_right", "hero_left", "center_float"],
        "mode_constraints": {
          "hero_right": {
            "max_width_pt": 380,
            "max_height_pt": 400,
            "anchor": "center",
            "image_ratio": 0.40
          },
          "hero_left": {
            "max_width_pt": 380,
            "max_height_pt": 400,
            "anchor": "center",
            "image_ratio": 0.40
          },
          "center_float": {
            "max_width_pt": 520,
            "max_height_pt": 340,
            "anchor": "center",
            "image_ratio": 0.55
          },
          "hero_top": {
            "max_width_pt": 840,
            "max_height_pt": 260,
            "anchor": "top_center",
            "image_ratio": 0.45
          }
        },
        "treatment": {
          "corner_radius_pt": 8,
          "border_role": "border_subtle",
          "shadow_role": "soft"
        },
        "caption": {
          "font_size": 11,
          "alignment": "center",
          "max_lines": 1,
          "prefix": ""
        }
      },
      "guidelines": [
        "一页一个强调色落点，其余全灰阶",
        "用细线分隔区块而非色块堆叠",
        "禁止渐变、发光、大圆角"
      ]
    },
